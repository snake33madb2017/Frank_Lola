---
const year = new Date().getFullYear();
---
<footer class="bg-navy py-16 mt-auto" id="contacto">
    <div class="max-w-7xl mx-auto px-6 flex flex-col items-center">
        <!-- Logo / Signature -->
        <a href="#home" class="mb-8">
            <img src="/Logo frank lola.png" alt="Frank Lola Signature" class="h-24 md:h-32 object-contain filter invert brightness-200" />
        </a>

        <!-- Social Icons -->
        <div class="flex gap-6 items-center mb-12">
            <a href="https://www.instagram.com/franklolalovo" target="_blank" class="text-text-main hover:text-gold transition-colors font-bold text-lg">IG</a>
            <a href="https://www.youtube.com/@franklola4.0" target="_blank" class="text-text-main hover:text-gold transition-colors font-bold text-lg">YT</a>
            <a href="https://www.facebook.com/share/1H5fP3pBa2/?mibextid=wwXIfr" target="_blank" class="text-text-main hover:text-gold transition-colors font-bold text-lg">FB</a>
            <a href="https://www.linkedin.com/in/franklola" target="_blank" class="text-text-main hover:text-gold transition-colors font-bold text-lg">IN</a>
            <a href="https://www.tiktok.com/@franklola_" target="_blank" class="text-text-main hover:text-gold transition-colors font-bold text-lg">TK</a>
        </div>

        <!-- Copyright & Links -->
        <div class="flex flex-col md:flex-row items-center gap-4 text-xs font-sans tracking-widest uppercase text-text-main font-bold">
            <span>&copy; {year} FRANK LOLA. TODOS LOS DERECHOS RESERVADOS.</span>
            <div class="hidden md:block text-gold">|</div>
            <a href="#" class="hover:text-gold transition-colors underline decoration-gold/50 underline-offset-4">TÉRMINOS</a>
            <div class="hidden md:block text-gold">|</div>
            <a href="#" class="hover:text-gold transition-colors underline decoration-gold/50 underline-offset-4">PRIVACIDAD</a>
            <div class="hidden md:block text-gold">|</div>
            <a href="#" class="hover:text-gold transition-colors underline decoration-gold/50 underline-offset-4">DISEÑADO POR...</a>
        </div>
    </div>
</footer>
