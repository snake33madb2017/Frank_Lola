---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "Frank Lola | Hospitality Consultant & Coach" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Frank Lola - Bartender, Coach & Mentor certificado por EMCC e ICF. Consultor especializado en hospitality." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
</head>
<body class="bg-zinc-950 text-zinc-200 font-sans antialiased flex flex-col min-h-screen selection:bg-accent selection:text-white">
    <slot />
</body>
</html>
