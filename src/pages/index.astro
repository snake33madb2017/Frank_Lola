---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
    <Header />
    <main>
        <!-- Hero Section -->
        <section class="relative min-h-screen pt-24 px-6 md:px-12 flex items-center justify-center bg-navy overflow-hidden">
            <!-- Background Image -->
            <div class="absolute inset-0 z-0">
                <img src="/foto1-placeholder.jpg" alt="Frank Lola Speaking" class="w-full h-full object-cover opacity-50 mix-blend-overlay" />
                <div class="absolute inset-0 bg-gradient-to-t from-navy via-transparent to-navy pointer-events-none"></div>
            </div>
            
            <div class="relative z-10 max-w-5xl mx-auto text-center mt-20">
                <h1 class="text-7xl md:text-9xl font-display font-black text-white leading-none tracking-tighter uppercase mb-2">
                    Frank Lola.
                </h1>
                <h2 class="text-gold font-display font-bold tracking-widest uppercase mb-8 text-sm md:text-base">
                    Hospitality / Mentor-Coach / Speaker
                </h2>
                
                <p class="text-lg md:text-xl text-text-main/90 mb-12 max-w-4xl mx-auto font-sans font-light uppercase leading-relaxed">
                    "Creo profundamente que la hospitalidad no es un privilegio, sino una necesidad global. Esta creencia guía cómo vivo y alimenta mi búsqueda de la verdadera hospitalidad. Estoy agradecido por cada momento de mi vida, bueno y malo, porque me han convertido en quien soy hoy. Mientras esté aquí, quiero mostrarle al mundo cómo una verdadera hospitalidad puede erradicar la hostilidad."
                </p>

                <a href="/about" class="bg-transparent border-2 border-gold text-gold px-10 py-4 rounded-full font-display font-bold uppercase tracking-widest hover:bg-gold hover:text-navy transition-all inline-block">
                    Saber Más
                </a>
            </div>
            
            <!-- Carousel placeholder at bottom of hero -->
            <div class="absolute bottom-0 left-0 w-full bg-surface border-t border-border-gold py-4 overflow-hidden z-20">
                <div class="flex gap-12 whitespace-nowrap animate-pulse opacity-70 items-center justify-center">
                    <span class="text-text-main font-bold uppercase tracking-widest">Four Roses</span>
                    <span class="text-text-main font-bold uppercase tracking-widest">Havana Club</span>
                    <span class="text-text-main font-bold uppercase tracking-widest">Beefeater</span>
                    <span class="text-text-main font-bold uppercase tracking-widest">Absolut</span>
                    <span class="text-text-main font-bold uppercase tracking-widest">Tatel Group</span>
                </div>
            </div>
        </section>

        <!-- Frank Lola Section (About Short) -->
        <section class="py-32 px-6 bg-navy relative">
            <div class="max-w-7xl mx-auto text-center">
                <h2 class="text-5xl md:text-7xl font-display font-black text-text-main mb-4 tracking-tighter uppercase">Frank Lola</h2>
                <h3 class="text-gold font-bold uppercase tracking-widest mb-8">Consultor. Speaker. Coach.</h3>
                <p class="text-text-main/80 text-xl font-light max-w-3xl mx-auto leading-relaxed">
                    Acompaño a directivos y equipos en la transformación del liderazgo y la experiencia de servicio. Fundador de <strong>Bar(o)Grama</strong> y <strong>Truly Hospitality</strong>, cofundador de <strong>Lovo Bar</strong> y <strong>The Flow Bros</strong>. Coaching ejecutivo (EMCC/ICF) con visión de primera línea.
                </p>
                <div class="mt-12">
                     <a href="/about" class="bg-transparent border border-gold text-text-main px-8 py-3 rounded-full font-display font-bold uppercase tracking-widest hover:bg-gold hover:text-navy transition-colors">
                        Saber Más &gt;
                    </a>
                </div>
            </div>
        </section>

        <!-- Banner 3 Photos Top -->
        <section class="py-10 bg-navy">
            <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-4 px-6">
                <div class="aspect-square bg-surface border border-border-gold flex items-center justify-center opacity-70 hover:opacity-100 transition-opacity">
                    <span class="text-gold uppercase tracking-widest">Foto 1 Placeholder</span>
                </div>
                <div class="aspect-square bg-surface border border-border-gold flex items-center justify-center opacity-70 hover:opacity-100 transition-opacity">
                    <span class="text-gold uppercase tracking-widest">Foto 2 Placeholder</span>
                </div>
                <div class="aspect-square bg-surface border border-border-gold flex items-center justify-center opacity-70 hover:opacity-100 transition-opacity">
                    <span class="text-gold uppercase tracking-widest">Foto 3 Placeholder</span>
                </div>
            </div>
        </section>

        <!-- What People Says -->
        <section class="py-32 px-6 bg-navy border-t border-border-gold">
            <div class="max-w-7xl mx-auto">
                <h2 class="text-4xl md:text-6xl font-display font-black text-center text-text-main mb-16 tracking-tighter uppercase">Lo Que Dice La Gente</h2>
                <div class="grid md:grid-cols-2 gap-8">
                    <!-- Testimonials placeholders -->
                    <div class="bg-surface p-8 rounded border border-border-gold">
                        <p class="text-text-main/80 italic mb-4">"Un gran profesional..."</p>
                        <p class="text-gold font-bold uppercase">- Pau Gasol</p>
                    </div>
                    <div class="bg-surface p-8 rounded border border-border-gold">
                        <p class="text-text-main/80 italic mb-4">"Excelente coach de liderazgo..."</p>
                        <p class="text-gold font-bold uppercase">- Minerva Tapial</p>
                    </div>
                    <div class="bg-surface p-8 rounded border border-border-gold">
                        <p class="text-text-main/80 italic mb-4">"Transformó nuestra visión de hospitalidad."</p>
                        <p class="text-gold font-bold uppercase">- Desmond Payne</p>
                    </div>
                    <div class="bg-surface p-8 rounded border border-border-gold">
                        <p class="text-text-main/80 italic mb-4">"Resultados increíbles."</p>
                        <p class="text-gold font-bold uppercase">- CR7</p>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
