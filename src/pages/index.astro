---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
    <Header />
    <main>
        <!-- Hero Section -->
        <section id="home" class="relative min-h-screen pt-24 px-6 md:px-12 flex items-center justify-center overflow-hidden bg-[url('/frank-lola-scaled.jpg')] bg-fixed bg-cover bg-center">
            <!-- Overlay -->
            <div class="absolute inset-0 bg-navy/60 mix-blend-multiply z-0"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-navy via-transparent to-navy/30 pointer-events-none z-0"></div>
            
            <div class="relative z-10 max-w-5xl mx-auto text-center mt-20 scroll-reveal reveal-hidden">
                <h1 class="text-7xl md:text-9xl font-display font-black text-white leading-none tracking-tighter uppercase mb-6 drop-shadow-2xl">
                    Frank Lola.
                </h1>
                
                <p class="text-lg md:text-2xl text-gold mb-12 max-w-4xl mx-auto font-display font-bold uppercase leading-relaxed scroll-reveal reveal-hidden reveal-delay-100">
                    Frank Lola es un verdadero investigador de la hospitalidad, bartender por pasión, coach & mentor por propósito, estratega de hospitalidad por experiencia.
                </p>

                <a href="#contacto" class="bg-transparent border-2 border-gold text-gold px-10 py-4 rounded-full font-display font-bold uppercase tracking-widest hover:bg-gold hover:text-navy transition-all inline-block scroll-reveal reveal-hidden reveal-delay-200">
                    Hablemos
                </a>
            </div>
            
            <!-- Carousel placeholder at bottom of hero -->
            <div class="absolute bottom-0 left-0 w-full bg-surface border-t border-border-gold py-4 overflow-hidden z-20">
                <div class="flex gap-12 whitespace-nowrap animate-pulse opacity-70 items-center justify-center">
                    <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Four Roses</span>
                    <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Havana Club</span>
                    <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Beefeater</span>
                    <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Absolut</span>
                    <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Tatel Group</span>
                </div>
            </div>
        </section>

        <!-- Frank Lola Section (About) -->
        <section id="about" class="py-32 px-6 bg-navy relative border-t border-border-gold">
            <div class="max-w-7xl mx-auto text-center scroll-reveal reveal-hidden">
                <h2 class="text-5xl md:text-7xl font-display font-black text-text-main mb-4 tracking-tighter uppercase">Frank Lola</h2>
                <h3 class="text-gold font-bold uppercase tracking-widest mb-8 scroll-reveal reveal-hidden reveal-delay-100">Hospitality / Mentor-Coach / Speaker</h3>
                <p class="text-text-main/90 text-lg md:text-xl font-light max-w-4xl mx-auto leading-relaxed scroll-reveal reveal-hidden reveal-delay-200 uppercase">
                    "I DEEPLY BELIEVE THAT HOSPITALITY ISN'T A PRIVILEGE, BUT A GLOBAL NECESSITY. THIS BELIEF GUIDES HOW I LIVE AND FUELS MY PURSUIT OF TRULY HOSPITALITY. I'M GRATEFUL FOR EVERY MOMENT OF MY LIFE, GOOD AND BAD, BECAUSE THEY'VE MADE ME WHO I AM TODAY. AS LONG AS I'M HERE, I WANT TO SHOW THE WORLD HOW A TRULY HOSPITALITY CAN ERADICATE HOSTILITY."
                </p>
                <div class="mt-12">
                     <a href="#about" class="bg-transparent border-2 border-gold text-gold px-10 py-4 rounded-full font-display font-bold uppercase tracking-widest hover:bg-gold hover:text-navy transition-all inline-block scroll-reveal reveal-hidden reveal-delay-300">
                        Saber Más
                    </a>
                </div>
            </div>
        </section>

        <!-- Long Story Short Section (Sticky Scroll) -->
        <section class="py-32 px-6 bg-navy relative border-t border-border-gold">
            <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-16 lg:gap-24 items-start">
                
                <!-- Sticky Title Left -->
                <div class="lg:w-1/3 lg:sticky lg:top-32 scroll-reveal reveal-hidden">
                    <h2 class="text-6xl md:text-8xl font-display font-black text-gold tracking-tighter uppercase leading-none drop-shadow-lg">
                        Long<br/>Story<br/>Short
                    </h2>
                    <div class="mt-8 w-24 h-1 bg-gradient-to-r from-gold to-transparent"></div>
                </div>

                <!-- Scrolling Content Right -->
                <div class="lg:w-2/3 flex flex-col gap-12 mt-8 lg:mt-0">
                    <p class="text-white md:text-lg font-sans tracking-widest leading-relaxed md:leading-loose uppercase opacity-90 scroll-reveal reveal-hidden">
                        He creado, liderado y acompañado proyectos, marcas y equipos, siempre buscando entender qué hay detrás de una gran barra: producto, técnica, negocio, cultura y, sobre todo, personas.
                    </p>

                    <div class="flex flex-col gap-8 scroll-reveal reveal-hidden reveal-delay-100">
                        <p class="text-white md:text-lg font-sans tracking-widest leading-relaxed md:leading-loose uppercase opacity-90">
                            Hoy esa experiencia se transforma en tres caminos:
                        </p>
                        
                        <div class="pl-6 md:pl-10 border-l-2 border-gold/30 flex flex-col gap-8">
                            <p class="text-white/80 text-sm md:text-base font-sans tracking-widest leading-relaxed uppercase hover:text-white transition-colors duration-300">
                                <span class="text-gold font-bold">Consultor,</span> ayudando a bares, marcas y empresas de hospitality a desarrollar conceptos, estrategias, barras y experiencias con sentido.
                            </p>
                            <p class="text-white/80 text-sm md:text-base font-sans tracking-widest leading-relaxed uppercase hover:text-white transition-colors duration-300">
                                <span class="text-gold font-bold">Speaker,</span> compartiendo historias, conocimiento y una visión de la hospitality construida desde la experiencia y la curiosidad.
                            </p>
                            <p class="text-white/80 text-sm md:text-base font-sans tracking-widest leading-relaxed uppercase hover:text-white transition-colors duration-300">
                                <span class="text-gold font-bold">Coach & Mentor,</span> acompañando a profesionales y líderes en su desarrollo, propósito y liderazgo.
                            </p>
                        </div>
                    </div>

                    <p class="text-white md:text-lg font-sans tracking-widest leading-relaxed md:leading-loose uppercase opacity-90 scroll-reveal reveal-hidden reveal-delay-200">
                        Soy fundador de <span class="text-gold">Bar(o)Grama</span> y <span class="text-gold">Truly Hospitality</span>, cofundador de <span class="text-gold">Lovo Bar</span> y, sobre todo, alguien que sigue creyendo que siempre queda algo nuevo por aprender.
                    </p>
                </div>
                
            </div>
        </section>

        <!-- 3 Caminos Section (Dynamic Full Width) -->
        <section class="py-24 bg-navy border-t border-border-gold overflow-hidden">
            <div class="text-center mb-20 px-6">
                <h2 class="text-5xl md:text-8xl font-display font-black bg-gradient-to-r from-gold via-yellow-200 to-gold bg-clip-text text-transparent tracking-tighter uppercase scroll-reveal reveal-hidden drop-shadow-2xl">
                    3 Caminos
                </h2>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 w-full border-y border-border-gold">
                
                <!-- Left: Consultant -->
                <div class="group relative px-8 py-24 flex flex-col items-center justify-center border-b md:border-b-0 md:border-r border-border-gold overflow-hidden cursor-pointer scroll-reveal reveal-hidden min-h-[400px]">
                    <!-- Hover Background Image -->
                    <div class="absolute inset-0 bg-[url('/hospitality_strategy.jpg')] bg-cover bg-center opacity-0 group-hover:opacity-40 transition-opacity duration-700 scale-110 group-hover:scale-100 ease-out z-0"></div>
                    <div class="absolute inset-0 bg-navy/95 group-hover:bg-navy/70 transition-colors duration-700 z-0"></div>
                    
                    <div class="relative z-10 transform group-hover:-translate-y-4 transition-transform duration-500 text-center">
                        <h3 class="text-gold font-display font-bold text-3xl md:text-4xl tracking-widest uppercase mb-8 group-hover:scale-110 transition-transform duration-500 drop-shadow-lg">
                            Consultant
                        </h3>
                        <p class="text-white text-sm md:text-base font-sans tracking-widest leading-loose uppercase max-w-sm mx-auto opacity-80 group-hover:opacity-100 transition-opacity duration-500 font-semibold drop-shadow-md">
                            Ayudando a bares, marcas y empresas de hospitality a desarrollar conceptos, estrategias, barras y experiencias con sentido.
                        </p>
                    </div>
                </div>

                <!-- Center: Coach Mentor -->
                <div class="group relative px-8 py-24 flex flex-col items-center justify-center border-b md:border-b-0 md:border-r border-border-gold overflow-hidden cursor-pointer scroll-reveal reveal-hidden reveal-delay-100 min-h-[400px]">
                    <!-- Hover Background Image -->
                    <div class="absolute inset-0 bg-[url('/coach_mentor.jpg')] bg-cover bg-center opacity-0 group-hover:opacity-40 transition-opacity duration-700 scale-110 group-hover:scale-100 ease-out z-0"></div>
                    <div class="absolute inset-0 bg-navy/95 group-hover:bg-navy/70 transition-colors duration-700 z-0"></div>
                    
                    <div class="relative z-10 transform group-hover:-translate-y-4 transition-transform duration-500 text-center">
                        <h3 class="text-gold font-display font-bold text-3xl md:text-4xl tracking-widest uppercase mb-8 group-hover:scale-110 transition-transform duration-500 drop-shadow-lg flex flex-col gap-2">
                            <span>Coach</span>
                            <span>Mentor</span>
                        </h3>
                        <p class="text-white text-sm md:text-base font-sans tracking-widest leading-loose uppercase max-w-sm mx-auto opacity-80 group-hover:opacity-100 transition-opacity duration-500 font-semibold drop-shadow-md">
                            Acompañando a profesionales y líderes en su desarrollo, propósito y liderazgo.
                        </p>
                    </div>
                </div>

                <!-- Right: Speaker -->
                <div class="group relative px-8 py-24 flex flex-col items-center justify-center overflow-hidden cursor-pointer scroll-reveal reveal-hidden reveal-delay-200 min-h-[400px]">
                    <!-- Hover Background Image -->
                    <div class="absolute inset-0 bg-[url('/bartender_passion.jpg')] bg-cover bg-center opacity-0 group-hover:opacity-40 transition-opacity duration-700 scale-110 group-hover:scale-100 ease-out z-0"></div>
                    <div class="absolute inset-0 bg-navy/95 group-hover:bg-navy/70 transition-colors duration-700 z-0"></div>
                    
                    <div class="relative z-10 transform group-hover:-translate-y-4 transition-transform duration-500 text-center">
                        <h3 class="text-gold font-display font-bold text-3xl md:text-4xl tracking-widest uppercase mb-8 group-hover:scale-110 transition-transform duration-500 drop-shadow-lg">
                            Speaker
                        </h3>
                        <p class="text-white text-sm md:text-base font-sans tracking-widest leading-loose uppercase max-w-sm mx-auto opacity-80 group-hover:opacity-100 transition-opacity duration-500 font-semibold drop-shadow-md">
                            Compartiendo historias, conocimiento y una visión de la hospitality construida desde la experiencia y la curiosidad.
                        </p>
                    </div>
                </div>

            </div>
        </section>

        <!-- NOWDAYS -->
        <section class="py-32 px-6 bg-navy relative border-t border-border-gold overflow-hidden">
            <div class="max-w-7xl mx-auto scroll-reveal reveal-hidden">
                <h2 class="text-6xl md:text-[8rem] font-display font-black text-gold tracking-tighter uppercase leading-none mb-12 drop-shadow-xl">
                    Nowdays
                </h2>
                <p class="text-white md:text-2xl font-sans tracking-widest leading-relaxed md:leading-loose uppercase opacity-90 max-w-4xl border-l-4 border-gold pl-6 md:pl-10">
                    Cree en la hospitalidad honesta y trata de aplicarla donde quiera que va ya sea a través de la filosofía de empresa, de la inspiración en charlas o a través del coaching...
                </p>
            </div>
        </section>

        <!-- THE FULL SCOOP -->
        <section class="py-32 px-6 bg-navy relative border-t border-border-gold overflow-hidden flex flex-col justify-center">
            <div class="max-w-7xl mx-auto w-full scroll-reveal reveal-hidden">
                <h2 class="text-6xl md:text-[8rem] font-display font-black text-gold tracking-tighter uppercase leading-none drop-shadow-xl">
                    The Full Scoop
                </h2>
                <h3 class="text-2xl md:text-4xl font-display font-bold text-gold tracking-widest uppercase mt-6 mb-12 drop-shadow-md">
                    Mi Esencia: Luces & Sombras, (Desafíos & Crecimientos)
                </h3>
            </div>
        </section>

        <!-- MI PROPOSITO -->
        <section class="py-32 px-6 bg-navy relative border-t border-border-gold flex flex-col items-center justify-center text-center">
            <div class="max-w-5xl mx-auto scroll-reveal reveal-hidden">
                <h2 class="text-5xl md:text-8xl font-display font-black text-gold tracking-tighter uppercase mb-16 drop-shadow-xl">
                    Mi Propósito
                </h2>
                <p class="text-white text-2xl md:text-4xl font-display font-bold tracking-widest leading-tight uppercase mb-12 drop-shadow-md">
                    Erradicar la hostilidad a través de la hospitalidad honesta.
                </p>
                <p class="text-white/80 md:text-xl font-sans tracking-widest leading-relaxed uppercase max-w-3xl mx-auto border-t border-gold/30 pt-8">
                    Servir es uno de los actos de amor más poderosos del ser humano y si no vives para servir a otros no sirves para vivir.
                </p>
            </div>
        </section>

        <!-- MI SECRETO -->
        <section class="py-32 px-6 bg-navy relative border-t border-border-gold flex flex-col items-center justify-center text-center">
            <div class="max-w-5xl mx-auto scroll-reveal reveal-hidden">
                <h2 class="text-5xl md:text-8xl font-display font-black text-gold tracking-tighter uppercase mb-16 drop-shadow-xl">
                    Mi Secreto
                </h2>
                <p class="text-white text-2xl md:text-4xl font-display font-bold tracking-widest leading-tight uppercase mb-12 drop-shadow-md">
                    Entender que en la diversidad está el único punto de unión entre seres humanos.
                </p>
                <p class="text-white/80 md:text-xl font-sans tracking-widest leading-relaxed uppercase max-w-3xl mx-auto border-t border-gold/30 pt-8">
                    Servir es uno de los actos de amor más poderosos del ser humano y si no vives para servir a otros no sirves para vivir.
                </p>
            </div>
        </section>

        <!-- 10 APRENDIZAJES -->
        <section class="py-32 px-6 bg-navy relative border-t border-border-gold">
            <div class="max-w-7xl mx-auto">
                <h2 class="text-5xl md:text-[6rem] font-display font-black text-gold tracking-tighter uppercase leading-none mb-16 drop-shadow-xl max-w-4xl scroll-reveal reveal-hidden">
                    10 Aprendizajes<br/>Que Hoy Me Definen
                </h2>
                
                <div class="flex flex-col gap-6 md:pl-12 max-w-4xl scroll-reveal reveal-hidden reveal-delay-100">
                    <ol class="list-decimal text-white md:text-xl font-sans tracking-widest leading-relaxed uppercase opacity-90 space-y-6 marker:text-gold marker:font-bold">
                        <li>Ser un eterno aprendiz.</li>
                        <li>Tener pasión por ayudar.</li>
                        <li>Revisar mi concepto de éxito ocasionalmente.</li>
                        <li>La realidad no cambia; cambia cómo la miro.</li>
                        <li>La felicidad es un estado de serenidad sostenida en el tiempo.</li>
                        <li>Aporto valor pensando en lo que el otro necesita.</li>
                        <li>Si hay aprendizaje, no hay fracaso.</li>
                        <li>Acepta lo que no puedes cambiar.</li>
                        <li>Enfócate en lo que sí depende de ti.</li>
                        <li>Mis prioridades definen mis pasos.</li>
                    </ol>
                </div>

                <div class="mt-20 flex justify-end scroll-reveal reveal-hidden reveal-delay-200">
                    <span class="text-6xl md:text-8xl font-display italic text-white/80 opacity-50 drop-shadow-md">
                        Frank Lola
                    </span>
                </div>
            </div>
        </section>

        <!-- What People Says -->
        <section class="py-32 px-6 bg-navy border-t border-border-gold">
            <div class="max-w-7xl mx-auto">
                <h2 class="text-4xl md:text-6xl font-display font-black text-center text-text-main mb-16 tracking-tighter uppercase scroll-reveal reveal-hidden">Lo Que Dice La Gente</h2>
                <div class="grid md:grid-cols-2 gap-8">
                    <!-- Testimonials -->
                    <div class="bg-surface p-8 rounded border border-border-gold hover:border-gold transition-colors scroll-reveal reveal-hidden">
                        <p class="text-text-main/80 italic mb-4">"Un gran profesional..."</p>
                        <p class="text-gold font-bold uppercase">- Pau Gasol</p>
                    </div>
                    <div class="bg-surface p-8 rounded border border-border-gold hover:border-gold transition-colors scroll-reveal reveal-hidden reveal-delay-100">
                        <p class="text-text-main/80 italic mb-4">"Excelente coach de liderazgo..."</p>
                        <p class="text-gold font-bold uppercase">- Minerva Tapial</p>
                    </div>
                    <div class="bg-surface p-8 rounded border border-border-gold hover:border-gold transition-colors scroll-reveal reveal-hidden reveal-delay-200">
                        <p class="text-text-main/80 italic mb-4">"Transformó nuestra visión de hospitalidad."</p>
                        <p class="text-gold font-bold uppercase">- Desmond Payne</p>
                    </div>
                    <div class="bg-surface p-8 rounded border border-border-gold hover:border-gold transition-colors scroll-reveal reveal-hidden reveal-delay-300">
                        <p class="text-text-main/80 italic mb-4">"Resultados increíbles."</p>
                        <p class="text-gold font-bold uppercase">- CR7</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sección de Blog -->
        <section id="blog" class="py-32 px-6 relative border-t border-border-gold bg-navy">
            <div class="max-w-7xl mx-auto relative z-10">
                <div class="flex flex-col md:flex-row justify-between items-end mb-16 scroll-reveal reveal-hidden">
                    <div>
                        <h2 class="text-4xl md:text-6xl font-display font-black text-text-main tracking-tighter uppercase drop-shadow-md mb-2">Blog</h2>
                        <p class="text-gold font-bold uppercase tracking-widest drop-shadow-md">Artículos y Reflexiones</p>
                    </div>
                    <a href="/blog" class="hidden md:inline-block bg-transparent text-text-main border-b border-gold hover:text-gold transition-colors font-sans uppercase tracking-widest text-sm pb-1 mt-6 md:mt-0">Ver todos los artículos</a>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Articulo 1 -->
                    <article class="group cursor-pointer scroll-reveal reveal-hidden">
                        <div class="overflow-hidden border border-border-gold mb-6 relative aspect-[4/3]">
                            <div class="absolute inset-0 bg-surface/50 group-hover:bg-transparent transition-colors z-10 duration-500"></div>
                            <img src="/blog-1-placeholder.jpg" alt="El verdadero significado de la hospitalidad" class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out" onerror="this.src='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 400 300\' fill=\'%231a202c\'%3E%3Crect width=\'400\' height=\'300\'/%3E%3C/svg%3E'; this.style.backgroundColor='#1a202c'" />
                        </div>
                        <div class="flex items-center gap-4 text-xs font-bold uppercase tracking-widest text-gold mb-3">
                            <span>Hospitality</span>
                            <span class="w-1 h-1 bg-gold rounded-full"></span>
                            <span>5 Min Read</span>
                        </div>
                        <h3 class="text-2xl font-display font-bold text-white uppercase tracking-tight mb-3 group-hover:text-gold transition-colors">
                            El verdadero significado de la hospitalidad
                        </h3>
                        <p class="text-white/70 font-sans leading-relaxed text-sm">
                            Descubre cómo la hospitalidad va más allá del servicio y se convierte en una filosofía de vida capaz de transformar experiencias.
                        </p>
                    </article>

                    <!-- Articulo 2 -->
                    <article class="group cursor-pointer scroll-reveal reveal-hidden reveal-delay-100">
                        <div class="overflow-hidden border border-border-gold mb-6 relative aspect-[4/3]">
                            <div class="absolute inset-0 bg-surface/50 group-hover:bg-transparent transition-colors z-10 duration-500"></div>
                            <img src="/blog-2-placeholder.jpg" alt="Liderazgo en la barra" class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out" onerror="this.src='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 400 300\' fill=\'%231a202c\'%3E%3Crect width=\'400\' height=\'300\'/%3E%3C/svg%3E'; this.style.backgroundColor='#1a202c'" />
                        </div>
                        <div class="flex items-center gap-4 text-xs font-bold uppercase tracking-widest text-gold mb-3">
                            <span>Liderazgo</span>
                            <span class="w-1 h-1 bg-gold rounded-full"></span>
                            <span>4 Min Read</span>
                        </div>
                        <h3 class="text-2xl font-display font-bold text-white uppercase tracking-tight mb-3 group-hover:text-gold transition-colors">
                            Liderazgo humano en la barra
                        </h3>
                        <p class="text-white/70 font-sans leading-relaxed text-sm">
                            Por qué los mejores equipos se construyen desde la empatía, el propósito común y el respeto mutuo.
                        </p>
                    </article>

                    <!-- Articulo 3 -->
                    <article class="group cursor-pointer scroll-reveal reveal-hidden reveal-delay-200">
                        <div class="overflow-hidden border border-border-gold mb-6 relative aspect-[4/3]">
                            <div class="absolute inset-0 bg-surface/50 group-hover:bg-transparent transition-colors z-10 duration-500"></div>
                            <img src="/blog-3-placeholder.jpg" alt="El futuro de la coctelería" class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out" onerror="this.src='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 400 300\' fill=\'%231a202c\'%3E%3Crect width=\'400\' height=\'300\'/%3E%3C/svg%3E'; this.style.backgroundColor='#1a202c'" />
                        </div>
                        <div class="flex items-center gap-4 text-xs font-bold uppercase tracking-widest text-gold mb-3">
                            <span>Tendencias</span>
                            <span class="w-1 h-1 bg-gold rounded-full"></span>
                            <span>6 Min Read</span>
                        </div>
                        <h3 class="text-2xl font-display font-bold text-white uppercase tracking-tight mb-3 group-hover:text-gold transition-colors">
                            El futuro de la coctelería
                        </h3>
                        <p class="text-white/70 font-sans leading-relaxed text-sm">
                            Una mirada a cómo la sostenibilidad y la conexión local están redefiniendo los menús del mañana.
                        </p>
                    </article>
                </div>

                <div class="mt-12 text-center md:hidden scroll-reveal reveal-hidden">
                    <a href="/blog" class="inline-block bg-transparent text-text-main border-b border-gold hover:text-gold transition-colors font-sans uppercase tracking-widest text-sm pb-1">Ver todos los artículos</a>
                </div>
            </div>
        </section>

        <!-- Placeholder for Videos -->
        <section id="videos" class="py-32 px-6 relative border-t border-border-gold bg-[url('/videos_bg.jpg')] bg-fixed bg-cover bg-center">
            <!-- Overlay -->
            <div class="absolute inset-0 bg-navy/80 mix-blend-multiply z-0"></div>
            <div class="max-w-7xl mx-auto text-center relative z-10 scroll-reveal reveal-hidden">
                <h2 class="text-4xl md:text-6xl font-display font-black text-text-main mb-4 tracking-tighter uppercase drop-shadow-md">Videos</h2>
                <p class="text-gold font-bold uppercase tracking-widest mb-8 drop-shadow-md">Canal de YouTube</p>
                <div class="h-64 bg-surface/50 backdrop-blur-md border border-border-gold flex items-center justify-center opacity-90">
                    <span class="text-text-main uppercase tracking-widest">Contenido de Videos (Próximamente)</span>
                </div>
            </div>
        </section>

        <!-- Placeholder for Bar(o)Grama -->
        <section id="barograma" class="py-32 px-6 relative border-t border-border-gold bg-[url('/barograma_bg.jpg')] bg-fixed bg-cover bg-center">
            <!-- Overlay -->
            <div class="absolute inset-0 bg-navy/80 mix-blend-multiply z-0"></div>
            <div class="max-w-7xl mx-auto text-center relative z-10 scroll-reveal reveal-hidden">
                <h2 class="text-4xl md:text-6xl font-display font-black text-text-main mb-4 tracking-tighter uppercase drop-shadow-md">Bar(O)Grama</h2>
                <p class="text-gold font-bold uppercase tracking-widest mb-8 drop-shadow-md">Consultoría</p>
                <div class="h-64 bg-surface/50 backdrop-blur-md border border-border-gold flex items-center justify-center opacity-90">
                    <span class="text-text-main uppercase tracking-widest">Contenido de Bar(O)Grama (Próximamente)</span>
                </div>
            </div>
        </section>

    </main>
    <Footer />
</Layout>

<script>
    // Intersection Observer for scroll animations
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add('reveal-active');
            }
        });
    }, {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px"
    });

    const hiddenElements = document.querySelectorAll('.reveal-hidden');
    hiddenElements.forEach((el) => observer.observe(el));
</script>
