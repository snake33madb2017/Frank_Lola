---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
    <Header />
    <main>
        <!-- Hero Section -->
        <section id="home" class="relative min-h-screen pt-24 px-6 md:px-12 flex items-center justify-center overflow-hidden bg-navy">
            <!-- Carousel Background -->
            <div class="absolute inset-0 z-0">
                <div class="hero-slide" style="background-image: url('/Foto%20FRANK%20LOLA%20%20BANNER%201.jpeg');"></div>
                <div class="hero-slide" style="background-image: url('/Foto%20FRANK%20LOLA%20%20BANNER%202.jpeg');"></div>
                <div class="hero-slide" style="background-image: url('/Foto%20FRANK%20LOLA%20%20BANNER%203.jpeg');"></div>
            </div>

            <!-- Overlay -->
            <div class="absolute inset-0 bg-navy/60 mix-blend-multiply z-0"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-navy via-transparent to-navy/30 pointer-events-none z-0"></div>
            
            <div class="relative z-10 max-w-5xl mx-auto text-center mt-20 scroll-reveal reveal-hidden">
                <h1 class="text-7xl md:text-9xl font-display font-black text-white leading-none tracking-tighter uppercase mb-6 drop-shadow-2xl">
                    Frank Lola.
                </h1>
                
                <p class="text-lg md:text-2xl text-gold mb-12 max-w-4xl mx-auto font-display font-bold uppercase leading-relaxed scroll-reveal reveal-hidden reveal-delay-100">
                    Frank Lola es un verdadero investigador de la hospitalidad, bartender por pasión, coach & mentor por propósito, estratega de hospitalidad por experiencia.
                </p>

                <a href="#contacto" class="bg-transparent border-2 border-gold text-gold px-10 py-4 rounded-full font-display font-bold uppercase tracking-widest hover:bg-gold hover:text-navy transition-all inline-block scroll-reveal reveal-hidden reveal-delay-200">
                    Hablemos
                </a>
            </div>
            
            <!-- Infinite Marquee Logos -->
            <div class="absolute bottom-0 left-0 w-full bg-surface border-t border-border-gold py-4 overflow-hidden z-20 flex">
                <div class="flex whitespace-nowrap animate-marquee opacity-70 hover:opacity-100 transition-opacity">
                    <!-- Set 1 -->
                    <div class="flex gap-16 px-8 items-center">
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Four Roses</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Havana Club</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Beefeater</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Absolut</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Tatel Group</span>
                    </div>
                    <!-- Set 2 -->
                    <div class="flex gap-16 px-8 items-center">
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Four Roses</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Havana Club</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Beefeater</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Absolut</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Tatel Group</span>
                    </div>
                    <!-- Set 3 -->
                    <div class="flex gap-16 px-8 items-center">
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Four Roses</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Havana Club</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Beefeater</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Absolut</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Tatel Group</span>
                    </div>
                    <!-- Set 4 -->
                    <div class="flex gap-16 px-8 items-center">
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Four Roses</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Havana Club</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Beefeater</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Absolut</span>
                        <span class="text-text-main font-bold uppercase tracking-widest hover:text-gold transition-colors">Tatel Group</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Trayectoria / Experiencia Section -->
        <section id="experiencia" class="py-32 px-6 bg-navy relative border-t border-border-gold overflow-hidden">
            <!-- Decorative Background Element -->
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-7xl opacity-30 pointer-events-none">
                <div class="absolute top-20 left-10 w-72 h-72 bg-gold/20 rounded-full blur-[100px]"></div>
                <div class="absolute bottom-20 right-10 w-96 h-96 bg-white/5 rounded-full blur-[120px]"></div>
            </div>

            <div class="max-w-7xl mx-auto relative z-10">
                <div class="text-center mb-20 scroll-reveal reveal-hidden">
                    <h2 class="text-5xl md:text-7xl font-display font-black text-white tracking-tighter uppercase mb-4">Trayectoria</h2>
                    <p class="text-gold font-bold uppercase tracking-widest">Colaboraciones, Medios y Reconocimientos</p>
                </div>

                <!-- Bento Grid for Lists -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                    
                    <!-- PRENSA ESCRITA -->
                    <div class="bg-white/5 border border-white/10 rounded-3xl p-8 hover:border-gold/50 transition-all duration-500 backdrop-blur-sm group scroll-reveal reveal-hidden">
                        <h3 class="text-gold font-display font-bold uppercase tracking-widest text-xl mb-6 border-b border-gold/30 pb-4 group-hover:pl-2 transition-all">Prensa Escrita</h3>
                        <ul class="flex flex-col text-white/70 text-xs md:text-sm tracking-wider uppercase font-sans">
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Robb Report</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">El País</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Muy Interesante</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Vanidad</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Cuore</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">ABC</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Excelencias</li>
                            <li class="py-2 hover:text-white hover:pl-2 transition-all">Pasión Habanos</li>
                        </ul>
                    </div>

                    <!-- INSTITUCIONES & LOCALES -->
                    <div class="bg-white/5 border border-white/10 rounded-3xl p-8 hover:border-gold/50 transition-all duration-500 backdrop-blur-sm group scroll-reveal reveal-hidden reveal-delay-100">
                        <h3 class="text-gold font-display font-bold uppercase tracking-widest text-xl mb-6 border-b border-gold/30 pb-4 group-hover:pl-2 transition-all">Instituciones & Locales</h3>
                        <ul class="flex flex-col text-white/70 text-xs md:text-sm tracking-wider uppercase font-sans overflow-y-auto max-h-[400px] pr-2 custom-scrollbar">
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Hotel Palace 5*</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Tatel Group</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">La Floridita</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Lovo Bar</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Arts Club</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Create Cocktails</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Atlantic Bar</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Astor Bar & Grill</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Beefeater Distillery</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Cámara de Comercio Madrid</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Escuela Hostelería El Lago</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Hoturis</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Madrid Hospitality School</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Bar(O)Grama</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Truly Hospitality</li>
                            <li class="py-2 hover:text-white hover:pl-2 transition-all">Flow Bros.</li>
                        </ul>
                    </div>

                    <!-- BRAND COLABS -->
                    <div class="bg-white/5 border border-white/10 rounded-3xl p-8 hover:border-gold/50 transition-all duration-500 backdrop-blur-sm group scroll-reveal reveal-hidden reveal-delay-200 lg:col-span-1">
                        <h3 class="text-gold font-display font-bold uppercase tracking-widest text-xl mb-6 border-b border-gold/30 pb-4 group-hover:pl-2 transition-all">Brand Colabs</h3>
                        <ul class="flex flex-col text-white/70 text-xs md:text-sm tracking-wider uppercase font-sans overflow-y-auto max-h-[400px] pr-2 custom-scrollbar">
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Beefeater Gin</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Plymouth Gin</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Havana Club</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Hendrick's Gin</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Flor de Caña</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Martin Miller's</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Absolut Vodka</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Ketel One</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Brandy Carlos I</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Johnnie Walker</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Martini</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Latin Gin</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Chivas Brothers</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Perrier Jouët</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Four Roses</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">The Glenlivet</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Mumm Champagne</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Ballantine's</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Jameson Whisky</li>
                            <li class="py-2 hover:text-white hover:pl-2 transition-all">Giffard</li>
                        </ul>
                    </div>

                    <!-- EVENTOS -->
                    <div class="bg-white/5 border border-white/10 rounded-3xl p-8 hover:border-gold/50 transition-all duration-500 backdrop-blur-sm group scroll-reveal reveal-hidden reveal-delay-300">
                        <h3 class="text-gold font-display font-bold uppercase tracking-widest text-xl mb-6 border-b border-gold/30 pb-4 group-hover:pl-2 transition-all">Eventos</h3>
                        <ul class="flex flex-col text-white/70 text-xs md:text-sm tracking-wider uppercase font-sans">
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">HIP</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">EMA MTV 2010</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Madrid Fusión</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Fíbar</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Guru of Spirits</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">FEBE</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Piña Agavera</li>
                            <li class="py-2 border-b border-white/5 hover:text-white hover:pl-2 transition-all">Belgrade Bar Show</li>
                            <li class="py-2 hover:text-white hover:pl-2 transition-all">Mediaset</li>
                        </ul>
                    </div>

                </div>

                <!-- PREMIOS & RECONOCIMIENTOS -->
                <div class="bg-gradient-to-br from-gold/20 to-navy border border-gold/30 rounded-3xl p-8 md:p-12 scroll-reveal reveal-hidden relative overflow-hidden group">
                    <div class="absolute -right-10 -top-10 text-[15rem] text-gold/10 font-display font-black leading-none pointer-events-none group-hover:scale-110 transition-transform duration-700">🏆</div>
                    
                    <h3 class="text-gold font-display font-black uppercase tracking-widest text-2xl md:text-3xl mb-10 relative z-10 flex items-center gap-4">
                        <span class="w-12 h-1 bg-gold"></span> Premios & Reconocimientos
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative z-10">
                        <div class="flex flex-col gap-2">
                            <span class="text-gold font-bold text-xl">2012</span>
                            <p class="text-white/90 uppercase tracking-widest text-sm leading-relaxed">
                                Best Brand Ambassador<br/>
                                <span class="text-white/50 text-xs">IBAA (International Brand Ambassador Awards)</span>
                            </p>
                        </div>
                        <div class="flex flex-col gap-2">
                            <span class="text-gold font-bold text-xl">2013</span>
                            <p class="text-white/90 uppercase tracking-widest text-sm leading-relaxed">
                                Cantinero de Honor<br/>
                                <span class="text-white/50 text-xs">Asociación de Cantineros de Cuba</span>
                            </p>
                        </div>
                        <div class="flex flex-col gap-2">
                            <span class="text-gold font-bold text-xl">2013</span>
                            <p class="text-white/90 uppercase tracking-widest text-sm leading-relaxed">
                                Absolut Bartender Pro<br/>
                                <span class="text-white/50 text-xs">Absolut Akademi</span>
                            </p>
                        </div>
                        <div class="flex flex-col gap-2">
                            <span class="text-gold font-bold text-xl">2015</span>
                            <p class="text-white/90 uppercase tracking-widest text-sm leading-relaxed">
                                Miembro Honorable<br/>
                                <span class="text-white/50 text-xs">Gin Guild (Por la aportación al mundo del Gin)</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Frank Lola Section (About) -->
        <section id="about" class="py-32 px-6 bg-navy relative border-t border-border-gold overflow-hidden">
            <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
                
                <!-- Image Side -->
                <div class="w-full lg:w-1/2 relative scroll-reveal reveal-hidden">
                    <!-- Marco decorativo desplazado -->
                    <div class="absolute -inset-4 border border-gold/30 translate-x-4 translate-y-4 z-0 hidden lg:block"></div>
                    <!-- Contenedor de la imagen -->
                    <div class="relative z-10 overflow-hidden shadow-2xl shadow-black/50 border border-border-gold">
                        <img src="/Sobre%20mi%20-%20Frank%20Lola.jpeg" alt="Frank Lola - Sobre mí" class="w-full h-auto object-cover grayscale hover:grayscale-0 transition-all duration-700 ease-out scale-100 hover:scale-105" />
                    </div>
                </div>

                <!-- Text Side -->
                <div class="w-full lg:w-1/2 flex flex-col items-start text-left scroll-reveal reveal-hidden">
                    <div class="mb-10 relative">
                        <!-- Marca de agua decorativa -->
                        <span class="absolute -left-12 -top-12 text-[10rem] text-white/5 font-display font-black leading-none pointer-events-none">01</span>
                        <h2 class="text-6xl md:text-[5.5rem] font-display font-black text-white tracking-tighter uppercase leading-none mb-6 drop-shadow-md relative z-10">Frank Lola</h2>
                        <h3 class="text-gold font-bold uppercase tracking-widest text-sm md:text-base border-l-2 border-gold pl-4 scroll-reveal reveal-hidden reveal-delay-100 relative z-10">Hospitality / Mentor-Coach / Speaker</h3>
                    </div>
                    
                    <div class="relative scroll-reveal reveal-hidden reveal-delay-200 mb-12 pl-6 md:pl-10 border-l-2 border-white/10">
                        <span class="absolute -top-6 -left-4 text-7xl text-gold/40 font-display italic leading-none pointer-events-none">"</span>
                        <p class="text-white/90 text-lg md:text-xl font-sans tracking-widest leading-relaxed uppercase relative z-10">
                            I DEEPLY BELIEVE THAT HOSPITALITY ISN'T A PRIVILEGE, BUT A GLOBAL NECESSITY. THIS BELIEF GUIDES HOW I LIVE AND FUELS MY PURSUIT OF TRULY HOSPITALITY. I'M GRATEFUL FOR EVERY MOMENT OF MY LIFE, GOOD AND BAD, BECAUSE THEY'VE MADE ME WHO I AM TODAY. AS LONG AS I'M HERE, I WANT TO SHOW THE WORLD HOW A TRULY HOSPITALITY CAN ERADICATE HOSTILITY.
                        </p>
                    </div>

                    <a href="#about" class="bg-transparent border-2 border-gold text-gold px-10 py-4 rounded-full font-display font-bold uppercase tracking-widest hover:bg-gold hover:text-navy transition-all inline-block scroll-reveal reveal-hidden reveal-delay-300">
                        Saber Más
                    </a>
                </div>

            </div>
        </section>

        <!-- Long Story Short Section (Sticky Scroll) -->
        <section class="py-32 px-6 bg-navy relative border-t border-border-gold">
            <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-16 lg:gap-24 items-start">
                
                <!-- Sticky Title Left -->
                <div class="lg:w-1/3 lg:sticky lg:top-32 scroll-reveal reveal-hidden">
                    <h2 class="text-6xl md:text-8xl font-display font-black text-gold tracking-tighter uppercase leading-none drop-shadow-lg">
                        Long<br/>Story<br/>Short
                    </h2>
                    <div class="mt-8 w-24 h-1 bg-gradient-to-r from-gold to-transparent"></div>
                </div>

                <!-- Scrolling Content Right -->
                <div class="lg:w-2/3 flex flex-col gap-12 mt-8 lg:mt-0">
                    <p class="text-white md:text-lg font-sans tracking-widest leading-relaxed md:leading-loose uppercase opacity-90 scroll-reveal reveal-hidden">
                        He creado, liderado y acompañado proyectos, marcas y equipos, siempre buscando entender qué hay detrás de una gran barra: producto, técnica, negocio, cultura y, sobre todo, personas.
                    </p>

                    <div class="flex flex-col gap-8 scroll-reveal reveal-hidden reveal-delay-100">
                        <p class="text-white md:text-lg font-sans tracking-widest leading-relaxed md:leading-loose uppercase opacity-90">
                            Hoy esa experiencia se transforma en tres caminos:
                        </p>
                        
                        <div class="pl-6 md:pl-10 border-l-2 border-gold/30 flex flex-col gap-8">
                            <p class="text-white/80 text-sm md:text-base font-sans tracking-widest leading-relaxed uppercase hover:text-white transition-colors duration-300">
                                <span class="text-gold font-bold">Consultor,</span> ayudando a bares, marcas y empresas de hospitality a desarrollar conceptos, estrategias, barras y experiencias con sentido.
                            </p>
                            <p class="text-white/80 text-sm md:text-base font-sans tracking-widest leading-relaxed uppercase hover:text-white transition-colors duration-300">
                                <span class="text-gold font-bold">Speaker,</span> compartiendo historias, conocimiento y una visión de la hospitality construida desde la experiencia y la curiosidad.
                            </p>
                            <p class="text-white/80 text-sm md:text-base font-sans tracking-widest leading-relaxed uppercase hover:text-white transition-colors duration-300">
                                <span class="text-gold font-bold">Coach & Mentor,</span> acompañando a profesionales y líderes en su desarrollo, propósito y liderazgo.
                            </p>
                        </div>
                    </div>

                    <p class="text-white md:text-lg font-sans tracking-widest leading-relaxed md:leading-loose uppercase opacity-90 scroll-reveal reveal-hidden reveal-delay-200">
                        Soy fundador de <span class="text-gold">Bar(o)Grama</span> y <span class="text-gold">Truly Hospitality</span>, cofundador de <span class="text-gold">Lovo Bar</span> y, sobre todo, alguien que sigue creyendo que siempre queda algo nuevo por aprender.
                    </p>
                </div>
                
            </div>
        </section>

        <!-- 3 Caminos Section (Dynamic Full Width) -->
        <section class="py-24 bg-navy border-t border-border-gold overflow-hidden">
            <div class="text-center mb-20 px-6">
                <h2 class="text-5xl md:text-8xl font-display font-black bg-gradient-to-r from-gold via-yellow-200 to-gold bg-clip-text text-transparent tracking-tighter uppercase scroll-reveal reveal-hidden drop-shadow-2xl">
                    3 Caminos
                </h2>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 w-full border-y border-border-gold">
                
                <!-- Left: Consultant -->
                <div class="group relative px-8 py-24 flex flex-col items-center justify-center border-b md:border-b-0 md:border-r border-border-gold overflow-hidden cursor-pointer scroll-reveal reveal-hidden min-h-[400px]">
                    <!-- Hover Background Image -->
                    <div class="absolute inset-0 bg-[url('/hospitality_strategy.jpg')] bg-cover bg-center opacity-0 group-hover:opacity-40 transition-opacity duration-700 scale-110 group-hover:scale-100 ease-out z-0"></div>
                    <div class="absolute inset-0 bg-navy/95 group-hover:bg-navy/70 transition-colors duration-700 z-0"></div>
                    
                    <div class="relative z-10 transform group-hover:-translate-y-4 transition-transform duration-500 text-center">
                        <h3 class="text-gold font-display font-bold text-3xl md:text-4xl tracking-widest uppercase mb-8 group-hover:scale-110 transition-transform duration-500 drop-shadow-lg">
                            Consultant
                        </h3>
                        <p class="text-white text-sm md:text-base font-sans tracking-widest leading-loose uppercase max-w-sm mx-auto opacity-80 group-hover:opacity-100 transition-opacity duration-500 font-semibold drop-shadow-md">
                            Ayudando a bares, marcas y empresas de hospitality a desarrollar conceptos, estrategias, barras y experiencias con sentido.
                        </p>
                    </div>
                </div>

                <!-- Center: Coach Mentor -->
