---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
    <Header />
    <main>
        <!-- Hero Section -->
        <section class="relative h-screen flex flex-col justify-center px-6 md:px-12">
            <div class="absolute inset-0 z-0 overflow-hidden">
                <img src="/frank-lola-scaled.jpg" alt="Frank Lola Hospitality Background" class="w-full h-full object-cover opacity-30 grayscale hover:scale-105 transition-transform duration-[20s] ease-out" />
                <div class="absolute inset-0 bg-zinc-950/60 bg-gradient-to-t from-zinc-950 via-transparent to-transparent"></div>
            </div>
            
            <div class="relative z-10 max-w-7xl w-full mx-auto animate-fade-in-up mt-20">
                <h2 class="text-accent font-display font-bold tracking-widest uppercase mb-4 text-sm md:text-base">Hospitality / Liderazgo / Cultura</h2>
                <h1 class="text-7xl md:text-[10rem] font-display font-black text-white leading-none tracking-tighter uppercase mb-6 drop-shadow-2xl">
                    Frank<br/>Lola.
                </h1>
                
                <!-- Animated Typewriter Paragraph -->
                <p class="text-xl md:text-3xl text-zinc-200 mb-12 max-w-3xl font-display font-bold uppercase leading-snug h-[4rem] md:h-[6rem]">
                    Convierte la hospitalidad genuina en <br class="hidden md:block" />
                    <span id="dynamic-text" class="text-accent"></span><span class="animate-pulse text-accent">|</span>
                </p>

                <div class="flex flex-col sm:flex-row gap-6">
                    <a href="/education" class="bg-white text-zinc-950 px-10 py-5 font-display font-bold uppercase tracking-widest hover:bg-accent hover:text-white transition-all text-center">Ver Programas</a>
                    <a href="/speaking" class="border-4 border-white text-white px-10 py-5 font-display font-bold uppercase tracking-widest hover:bg-white hover:text-zinc-950 transition-all text-center">Conferencias</a>
                </div>
            </div>
        </section>

        <!-- About Section -->
        <section class="py-32 px-6 bg-zinc-950 border-t border-zinc-900">
            <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16 items-center">
                <div class="order-2 md:order-1 relative group">
                    <div class="overflow-hidden shadow-2xl relative">
                        <img src="/xfm-frank-lola-01-1.jpg" alt="Frank Lola Portrait" class="w-full aspect-[4/5] object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-1000" />
                        <div class="absolute inset-0 border-2 border-transparent group-hover:border-accent/50 transition-colors duration-1000"></div>
                    </div>
                    <div class="absolute -bottom-10 -right-6 md:-right-10 bg-accent text-white p-8 shadow-2xl group-hover:-translate-y-2 transition-transform duration-700">
                        <p class="text-6xl font-display font-black leading-none">20+</p>
                        <p class="text-sm font-bold uppercase tracking-widest mt-2">Años Exp</p>
                    </div>
                </div>
                <div class="order-1 md:order-2">
                    <h2 class="text-5xl md:text-7xl font-display font-black text-white mb-8 tracking-tighter uppercase leading-none">Alineando Personas & Propósito.</h2>
                    <div class="text-zinc-400 space-y-6 text-xl font-light">
                        <p>Acompaño a directivos y equipos en la transformación del liderazgo y la experiencia de servicio.</p>
                        <p>Fundador de <strong class="text-white">Bar(o)Grama</strong> y <strong class="text-white">Truly Hospitality</strong>, cofundador de <strong class="text-white">Lovo Bar</strong> y <strong class="text-white">The Flow Bros</strong>.</p>
                        <p class="font-display font-bold text-white text-2xl uppercase pt-4 border-t border-zinc-800">Coaching ejecutivo (EMCC/ICF) con visión de primera línea.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<script>
    // Script de efecto máquina de escribir dinámica
    const words = [
        "tu ventaja estratégica.", 
        "el adn de tu equipo.", 
        "tu mejor experiencia.", 
        "tu motor de ventas."
    ];
    let i = 0;
    const el = document.getElementById('dynamic-text');

    if (el) {
        function typingEffect() {
            let word = words[i].split("");
            const loopTyping = function() {
                if (word.length > 0) {
                    el.innerHTML += word.shift();
                    setTimeout(loopTyping, 70);
                } else {
                    setTimeout(deletingEffect, 2500);
                }
            };
            loopTyping();
        }

        function deletingEffect() {
            let word = el.innerHTML;
            const loopDeleting = function() {
                if (word.length > 0) {
                    word = word.substring(0, word.length - 1);
                    el.innerHTML = word;
                    setTimeout(loopDeleting, 30);
                } else {
                    i = (i + 1) % words.length;
                    setTimeout(typingEffect, 500);
                }
            };
            loopDeleting();
        }

        // Iniciar el efecto después de 1 segundo
        setTimeout(typingEffect, 1000);
    }
</script>
